{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/constitution.md"],
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}",
        "X-MCP-Toolsets": "default,projects,actions"
      }
    }
  }
}
